# Stripe test secret key. Keep this server-only variable out of source control.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_RESIDENT_PRICE_ID=price_replace_me
STRIPE_PROGRAM_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public URL of the app. Use http://localhost:3000 in .env.local and the
# canonical production URL in Vercel's Production environment.
APP_URL=https://residencyphoto.com

# Neon Auth and Data API endpoints from the Neon Console.
NEON_AUTH_BASE_URL=https://your-project.neonauth.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_AUTH_URL=https://your-project.neonauth.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://your-project.apirest.aws.neon.tech/neondb/rest/v1

# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace_with_at_least_32_random_characters

# Pooled Neon Postgres connection string used by Drizzle on the server only.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Comma-separated list of emails allowed into /admin. Server-only, checked by
# /api/admin/verify.
ADMIN_EMAILS=you@residencyphoto.com

# Sentry error tracking. The DSN is a public value (it ships in the client
# bundle); keep it in Vercel's Production/Preview environments too.
NEXT_PUBLIC_SENTRY_DSN=https://<key>@o4508808579514368.ingest.us.sentry.io/4512103720550400
SENTRY_ORG=intelogroup
SENTRY_PROJECT=residencyphoto
# Optional: Sentry auth token with project:write scope. Enables sourcemap
# upload at build time. Server-only; set in Vercel, never commit.
SENTRY_AUTH_TOKEN=

# PostHog product analytics. The project key is public (it ships in the
# client bundle); the /ingest reverse proxy in next.config.ts keeps it
# first-party. Set both in Vercel's Production/Preview environments too.
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
